{
  "name": "apiview",
  "displayName": "ApiView",
  "description": "Visualize OpenAPI and AsyncAPI files: all endpoints/channels and their fields.",
  "version": "0.2.2",
  "publisher": "RicardoDevPt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/RicardoDevPt/ApiView.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "apiview.preview",
        "title": "ApiView: Preview",
        "icon": "$(preview)"
      },
      {
        "command": "apiview.reveal",
        "title": "ApiView: Show in Preview"
      },
      {
        "command": "apiview.goToSource",
        "title": "Go to Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiview.unfavorite",
        "title": "Remove from Favorites",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiview",
          "title": "ApiView",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "apiview": [
        {
          "id": "apiview.favorites",
          "name": "Favorites"
        },
        {
          "id": "apiview.endpoints",
          "name": "Endpoints"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiview.favorites",
        "contents": "Star a preview (☆ in its top-right corner) to pin it here."
      },
      {
        "view": "apiview.endpoints",
        "contents": "Open an OpenAPI/AsyncAPI YAML/JSON file to list its endpoints or channels.\n[Open Preview](command:apiview.preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "apiview.preview",
          "when": "resourceLangId =~ /yaml|json/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "apiview.preview",
          "when": "resourceLangId =~ /yaml|json/"
        }
      ],
      "view/title": [
        {
          "command": "apiview.preview",
          "when": "view == apiview.endpoints",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "apiview.goToSource",
          "when": "view == apiview.endpoints && viewItem == operation",
          "group": "inline"
        },
        {
          "command": "apiview.unfavorite",
          "when": "view == apiview.favorites && viewItem == favorite",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "apiview.reveal",
          "when": "false"
        },
        {
          "command": "apiview.goToSource",
          "when": "false"
        },
        {
          "command": "apiview.unfavorite",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node out/test.js",
    "package": "vsce package --allow-missing-repository",
    "preinstall": "node -e \"if (Number(process.versions.node.split('.')[0]) < 22) { console.error('Node.js 22 or newer is required. Run: nvm install 22 && nvm use 22'); process.exit(1); }\""
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.85",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "icon": "media/icon.png"
}
